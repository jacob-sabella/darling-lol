diff --git a/src/frameworks/Accessibility/CMakeLists.txt b/src/frameworks/Accessibility/CMakeLists.txt
new file mode 100644
index 000000000..6aa3783d1
--- /dev/null
+++ b/src/frameworks/Accessibility/CMakeLists.txt
@@ -0,0 +1,34 @@
+project(Accessibility)
+
+remove_sdk_framework(Accessibility)
+
+# The checked-in SDK is only rebuilt with REGENERATE_SDK, so this framework has to
+# find its own headers.
+include_directories(${CMAKE_CURRENT_SOURCE_DIR}/include)
+
+set(DYLIB_COMPAT_VERSION "1.0.0")
+set(DYLIB_CURRENT_VERSION "0.0.0")
+
+set(FRAMEWORK_VERSION "A")
+
+generate_sdk_framework(Accessibility
+    VERSION ${FRAMEWORK_VERSION}
+    HEADER "include/Accessibility"
+)
+
+add_framework(Accessibility
+    # src/libaccessibility already defines a target called Accessibility.
+    TARGET_NAME AccessibilityFramework
+    FAT
+    CURRENT_VERSION
+    VERSION ${FRAMEWORK_VERSION}
+
+    SOURCES
+        src/Accessibility.m
+
+    DEPENDENCIES
+        system
+        objc
+        Foundation
+        CoreFoundation
+)
