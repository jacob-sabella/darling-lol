+#import <QuickLookUI/QLPreviewPanel.h>
+
+// Chromium links QuickLookUI for the one class symbol _OBJC_CLASS_$_QLPreviewPanel
+// (LC_LOAD_DYLIB, not weak), so the image has to exist before the Electron
+// Framework will load at all. Quick Look previews themselves are never reached
+// by a client that has no Quick Look UI, so every message is absorbed and logged
+// rather than implemented.
+
+@implementation QLPreviewPanel
+
+@synthesize dataSource = _dataSource;
+@synthesize delegate = _delegate;
+@synthesize currentPreviewItemIndex = _currentPreviewItemIndex;
+
++ (QLPreviewPanel *)sharedPreviewPanel {
+    static QLPreviewPanel *shared = nil;
+    static dispatch_once_t once;
+    dispatch_once(&once, ^{
+        shared = [[QLPreviewPanel alloc] init];
+    });
+    return shared;
+}
+
++ (BOOL)sharedPreviewPanelExists {
+    return NO;
+}
+
+- (void)reloadData {
+}
+
+- (void)refreshCurrentPreviewItem {
+}
+
+- (void)updateController {
+}
+
+- (NSMethodSignature *)methodSignatureForSelector:(SEL)aSelector {
+    return [NSMethodSignature signatureWithObjCTypes: "v@:"];
+}
+
+- (void)forwardInvocation:(NSInvocation *)anInvocation {
+    NSLog(@"Stub called: %@ in %@", NSStringFromSelector([anInvocation selector]), [self class]);
+}
+
+@end
