+/* LOL_UX: temporary instrumentation - remove before commit */
+extern "C" FILE *lol_err_file(void)
+{
+    static FILE *f = NULL;
+    if (!f) {
+        f = fopen("/tmp/lol_err.log", "a");
+        if (f) setvbuf(f, NULL, _IOLBF, 0);
+    }
+    return f ? f : stderr;
