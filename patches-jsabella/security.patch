+    FILE *out = lol_err_file();
+    fprintf(out, "LOL_UX[%d]: %s code=%d backtrace:\n", (int)getpid(), tag, code);
+    void **fp = (void **)__builtin_frame_address(0);
+    for (int i = 0; i < 32; i++) {
+        if (!fp || ((uintptr_t)fp & 7)) break;
+        void *ret = fp[1];
+        void **nextfp = (void **)fp[0];
+        if (!ret) break;
+        Dl_info info;
+        if (dladdr(ret, &info) && info.dli_sname) {
+            const char *base = info.dli_fname ? strrchr(info.dli_fname, '/') : NULL;
+            fprintf(out, "LOL_UX:   %-24s %s+0x%lx\n", base ? base + 1 : "?",
+                    info.dli_sname, (unsigned long)((char *)ret - (char *)info.dli_saddr));
+        } else {
+            fprintf(out, "LOL_UX:   %p\n", ret);
+        }
+        if (nextfp <= fp) break;
+        fp = nextfp;
+    }
+    fflush(out);
+}
