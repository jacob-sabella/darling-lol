+/**
+ * Drops whatever this map's shared entries describe within [start, end).
+ *
+ * A shared entry only records where a memfd is currently mapped, so it has to
+ * follow the mapping. Once a range is unmapped the address can be handed
+ * straight back out for an unrelated mapping, and because the tree is keyed on
+ * address alone, a stale entry left behind there does not merely waste a memfd:
+ * RB_INSERT treats the new entry as a duplicate and keeps the old one, so the
+ * range silently goes on naming the wrong memory.
+ */
+static void dtape_map_remove_shared_range_locked(dtape_map_t* map, uint64_t start, uint64_t end) {
+	if (end <= start) {
+		return;
+	}
+
+	for (;;) {
+		dtape_map_shared_entry_t* entry;
+		dtape_map_shared_entry_t* overlapping = NULL;
+		dtape_map_shared_entry_t* tail = NULL;
+
+		RB_FOREACH(entry, dtape_map_shared_entry_head, &map->shared_entries) {
+			if (entry->address < end && start < entry->address + entry->size) {
+				overlapping = entry;
+				break;
+			}
+		}
+
+		if (!overlapping) {
+			return;
+		}
+
+		RB_REMOVE(dtape_map_shared_entry_head, &map->shared_entries, overlapping);
+
+		// Removing from the middle of an entry leaves a piece on either side.
+		if (end < overlapping->address + overlapping->size) {
+			tail = dtape_map_shared_entry_create(end,
+				overlapping->address + overlapping->size - end,
+				overlapping->page_offset + ((end - overlapping->address) >> PAGE_SHIFT),
+				overlapping->descriptor);
+			if (!tail) {
+				dtape_log_error("out of memory splitting a shared mapping; dropping [0x%llx, 0x%llx)", (unsigned long long) end, (unsigned long long) (overlapping->address + overlapping->size));
+			}
+		}
+
+		if (overlapping->address < start) {
+			// The head keeps its address, so the tree key is unchanged and it
+			// can go straight back in; only its length shrinks.
+			overlapping->size = start - overlapping->address;
+			dtape_map_insert_shared_entry_locked(map, overlapping);
+		} else {
+			dtape_map_shared_entry_destroy(overlapping);
+		}
+
+		if (tail) {
+			dtape_map_insert_shared_entry_locked(map, tail);
+		}
+
+		// Neither piece intersects [start, end) any more, so this terminates.
+	}
+};
