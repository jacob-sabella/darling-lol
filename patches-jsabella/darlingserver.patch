+static void dtape_map_remove_shared_range(dtape_map_t* map, uint64_t start, uint64_t end) {
+	dtape_mutex_lock(&map->shared_entry_lock);
+	dtape_map_remove_shared_range_locked(map, start, end);
+	dtape_mutex_unlock(&map->shared_entry_lock);
+};
