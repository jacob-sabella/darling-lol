diff --git a/src/IOObject.cpp b/src/IOObject.cpp
index 232f150..37d4adc 100644
--- a/src/IOObject.cpp
+++ b/src/IOObject.cpp
@@ -69,6 +69,17 @@ IOObject::IOObject()
 
 IOObject::~IOObject()
 {
+	if (m_dispatchSource)
+	{
+		// Cancelling before releasing is not optional.  The source is resumed and
+		// its handler block captures this, so releasing it while it is still live
+		// leaves libdispatch free to run that handler against an object that has
+		// just been freed - and it is a use of a cancelled-source-less release
+		// that libdispatch itself calls a bug in its client.
+		dispatch_source_cancel(m_dispatchSource);
+		dispatch_release(m_dispatchSource);
+	}
+
 	m_objects.erase(m_port);
 	// A receive source must be cancelled before its receive right is destroyed.
 	// The cancellation handler captures the port value, never the dying object.
