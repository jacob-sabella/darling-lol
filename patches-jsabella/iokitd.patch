+void IOSurface::createBackingStore()
+{
+	char path[PATH_MAX];
+
+	// Every process that gets handed the surface has to be able to map it, and
+	// they do not all run as the same user as iokitd.
+	mkdir(kIOSurfaceBackingStoreDirectory, 0777);
+	chmod(kIOSurfaceBackingStoreDirectory, 0777);
+
+	_IOSurfaceBackingStorePath(m_id, path, sizeof(path));
+
+	int fd = open(path, O_RDWR | O_CREAT | O_TRUNC, 0666);
+
+	if (fd < 0)
+		throw std::runtime_error(std::string("Cannot create surface backing store: ") + strerror(errno));
+
+	// open() went through the umask, which nothing here controls.
+	fchmod(fd, 0666);
+
+	if (ftruncate(fd, (off_t) m_allocSize) != 0)
+	{
+		int error = errno;
+
+		close(fd);
+		unlink(path);
+
+		throw std::runtime_error(std::string("Cannot size surface backing store: ") + strerror(error));
+	}
+
+	// Nothing in iokitd looks at the pixels, so the descriptor is of no further
+	// use here; the file stays until the surface is destroyed.
+	close(fd);
+}
+
+void IOSurface::removeBackingStore()
+{
+	char path[PATH_MAX];
+
+	_IOSurfaceBackingStorePath(m_id, path, sizeof(path));
+	unlink(path);
+}
+
+size_t IOSurface::describe(void* buffer, size_t capacity) const
+{
+	size_t needed = sizeof(_IOSurfaceObjectRetval)
+			+ (m_planes.size() - 1) * sizeof(_IOSurfacePlane);
+
+	if (capacity < needed)
+		return 0;
+
+	_IOSurfaceObjectRetval* out = (_IOSurfaceObjectRetval*) buffer;
+
+	out->surfaceID = m_id;
+	out->pixelFormat = m_pixelFormat;
+	out->address = 0;
+	out->allocSize = m_allocSize;
+	out->planeCount = (uint32_t) m_planes.size();
+
+	memcpy(out->planes, m_planes.data(), m_planes.size() * sizeof(_IOSurfacePlane));
+
+	return needed;
+}
