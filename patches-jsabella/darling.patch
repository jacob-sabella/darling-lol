+
+// What a surface's storage is rounded to. Callers size their own buffers with
+// these before handing the numbers back in the creation properties, so the
+// answers have to agree with what iokitd does when it lays a surface out.
+size_t IOSurfaceGetPropertyAlignment(CFStringRef property)
+{
+	if (CFEqual(property, kIOSurfaceBytesPerRow) ||
+		CFEqual(property, kIOSurfacePlaneBytesPerRow) ||
+		CFEqual(property, kIOSurfaceOffset) ||
+		CFEqual(property, kIOSurfacePlaneOffset) ||
+		CFEqual(property, kIOSurfacePlaneBase))
+	{
+		return 16;
+	}
+
+	if (CFEqual(property, kIOSurfaceAllocSize) ||
+		CFEqual(property, kIOSurfacePlaneSize))
+	{
+		return 4096;
+	}
+
+	return 1;
+}
+
+size_t IOSurfaceAlignProperty(CFStringRef property, size_t value)
+{
+	size_t alignment = IOSurfaceGetPropertyAlignment(property);
+
+	return (value + alignment - 1) & ~(alignment - 1);
+}
+
+size_t IOSurfaceGetPropertyMaximum(CFStringRef property)
+{
+	if (CFEqual(property, kIOSurfaceWidth) ||
+		CFEqual(property, kIOSurfaceHeight) ||
+		CFEqual(property, kIOSurfacePlaneWidth) ||
+		CFEqual(property, kIOSurfacePlaneHeight))
+	{
+		return 32768;
+	}
+
+	if (CFEqual(property, kIOSurfacePlaneInfo))
+	{
+		return 8;
+	}
+
+	// Anything else is limited by what can actually be allocated rather than by
+	// a rule of its own.
+	return 0;
+}
