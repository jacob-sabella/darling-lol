+
+/* How many times secure event input has been asked for and not yet given back.
+   The real calls nest, and a program that pushes a password field inside another
+   one relies on that, so the count is what decides when the mode is off again. */
+static _Atomic int secureEventInputCount = 0;
+
+/* There is no way to take the keyboard away from the rest of the system here:
+   nothing under this runtime can stop another client of the same X display from
+   reading key events, so this records that the mode was asked for and answers
+   questions about it truthfully, and the typing it is wrapped around is no more
+   private than any other.  Failing the call instead would not protect anything -
+   the caller carries on either way - and would only cost the sign-in form that
+   depends on it, so the request is accepted. */
+OSStatus EnableSecureEventInput(void)
+{
+	secureEventInputCount++;
+	return 0;
+}
+
+OSStatus DisableSecureEventInput(void)
+{
+	/* A disable that was never matched by an enable is the caller's mistake, and
+	   it must not drive the count negative - that would leave the mode reading as
+	   off while a later enable is still outstanding. */
+	int count = secureEventInputCount;
+
+	while (count > 0 && !__c11_atomic_compare_exchange_weak(&secureEventInputCount, &count, count - 1,
+	                                                        __ATOMIC_SEQ_CST, __ATOMIC_SEQ_CST))
+		;
+
+	return 0;
+}
+
+Boolean IsSecureEventInputEnabled(void)
+{
+	return secureEventInputCount > 0;
+}
