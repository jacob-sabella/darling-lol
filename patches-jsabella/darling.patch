diff --git a/CMakeLists.txt b/CMakeLists.txt
index 918cdd142..73b32f472 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -201,6 +201,15 @@ install(DIRECTORY DESTINATION libexec/darling/private)
 install(DIRECTORY DESTINATION libexec/darling/private/etc)
 install(DIRECTORY DESTINATION libexec/darling/private/var)
 install(DIRECTORY DESTINATION libexec/darling/private/tmp)
+install(DIRECTORY DESTINATION libexec/darling/private/var/tmp)
+
+# /tmp and /var/tmp are 1777 on macOS, and they have to be here too: everything
+# inside the prefix runs as the unprivileged user, so with CMake's default 0755
+# root-owned directories nothing can create a temporary file at all. CMake's
+# permission keywords cannot express the sticky bit, hence the explicit chmod.
+foreach(_darling_tmp_dir private/tmp private/var/tmp)
+	install(CODE "execute_process(COMMAND chmod 1777 \"\$ENV{DESTDIR}${CMAKE_INSTALL_PREFIX}/libexec/darling/${_darling_tmp_dir}\")")
+endforeach()
 InstallSymlink(private/etc ${CMAKE_INSTALL_PREFIX}/libexec/darling/etc)
 InstallSymlink(private/var ${CMAKE_INSTALL_PREFIX}/libexec/darling/var)
 
