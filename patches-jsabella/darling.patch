 void AudioConverter::flush()
 {
 	TRACE();
-	avcodec_flush_buffers(m_decoder);
-	avcodec_flush_buffers(m_encoder);
+
+	/* The encoder is only opened once the first packet has been seen, and
+	   avcodec_flush_buffers() goes straight through the context's codec
+	   pointer, so flushing a converter that has not converted anything yet -
+	   which is exactly what an application does when it resets one before use -
+	   would dereference null. */
+	if (m_decoder != nullptr && avcodec_is_open(m_decoder))
+		avcodec_flush_buffers(m_decoder);
+	if (m_encoder != nullptr && avcodec_is_open(m_encoder))
+		avcodec_flush_buffers(m_encoder);
 	//avcodec_close(m_encoder);
 }
 
+/* Chromium's GPU process disposes of a decoder whose converter it never created,
+   and the stale field it passes - freed memory, carrying whatever the allocator
+   left there - was dereferenced on the spot and took the process down.  Keeping
+   track of which references are live costs one hash lookup per call and turns
+   that into the paramErr the API is documented to answer with. */
+static std::mutex g_liveConvertersMutex;
+static std::unordered_set<const void*> g_liveConverters;
+
+bool AudioConverter::isLive(const void* converter)
+{
+	if (converter == nullptr)
+		return false;
+
+	std::lock_guard<std::mutex> lock(g_liveConvertersMutex);
+	return g_liveConverters.find(converter) != g_liveConverters.end();
+}
+
+static void rememberConverter(const void* converter)
+{
+	std::lock_guard<std::mutex> lock(g_liveConvertersMutex);
+	g_liveConverters.insert(converter);
+}
+
+static void forgetConverter(const void* converter)
+{
+	std::lock_guard<std::mutex> lock(g_liveConvertersMutex);
+	g_liveConverters.erase(converter);
+}
