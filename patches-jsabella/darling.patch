+// Attachments live in iokitd with the rest of the surface - see
+// IOSurfaceRoot::setSurfaceValues(). IOKit's struct input is one flat buffer,
+// so the surface is named by a header and the values follow it serialized.
+- (kern_return_t) _sendValues: (CFTypeRef) payload forMethod: (uint32_t) selector
+{
+	ImplData* data = (ImplData*) _impl;
+	CFDataRef serialized = IOCFSerialize(payload, kIOCFSerializeToBinary);
+
+	if (!serialized)
+		return kIOReturnUnsupported;
+
+	CFIndex length = CFDataGetLength(serialized);
+	struct _IOSurfaceValueRequest* request = malloc(sizeof(*request) + length);
+
+	request->surfaceID = data->surface->surfaceID;
+	request->reserved = 0;
+	memcpy(request->payload, CFDataGetBytePtr(serialized), length);
+	CFRelease(serialized);
+
+	kern_return_t ret = IOConnectCallMethod(g_surfaceService, selector, NULL, 0,
+			request, sizeof(*request) + length, NULL, 0, NULL, 0);
+
+	free(request);
+	return ret;
+}
