+double CVDisplayLinkGetActualOutputVideoRefreshPeriod( CVDisplayLinkRef CV_NONNULL displayLink )
+{
+	if (!displayLink || !impl(displayLink)->_running)
+		return 0.0;
+
+	return 1.0 / refreshRateForDisplay(impl(displayLink)->_displayID);
+}
+
+CVReturn CVDisplayLinkGetCurrentTime( CVDisplayLinkRef CV_NONNULL displayLink, CVTimeStamp * CV_NONNULL outTime )
+{
+	if (!displayLink || !outTime)
+		return kCVReturnInvalidArgument;
+
+	[impl(displayLink) fillTimeStamp: outTime framesFromNow: 0];
+	return kCVReturnSuccess;
+}
+
+CVReturn CVDisplayLinkTranslateTime( CVDisplayLinkRef CV_NONNULL displayLink, const CVTimeStamp * CV_NONNULL inTime, CVTimeStamp * CV_NONNULL outTime )
+{
+	if (!displayLink || !inTime || !outTime)
+		return kCVReturnInvalidArgument;
+
+	CVDisplayLinkImpl* link = impl(displayLink);
+	int64_t period = [link videoRefreshPeriod];
+
+	CVTimeStamp reference;
+	[link fillTimeStamp: &reference framesFromNow: 0];
+
+	// Only one direction is ever asked for in practice: fill in whichever of
+	// the two clocks the caller left out, using "now" as the common point.
+	*outTime = *inTime;
+	outTime->videoTimeScale = kVideoTimeScale;
+	outTime->videoRefreshPeriod = period;
+	outTime->rateScalar = 1.0;
+
+	if ((inTime->flags & kCVTimeStampHostTimeValid) && !(inTime->flags & kCVTimeStampVideoTimeValid))
+	{
+		int64_t deltaNs = int64_t(hostTimeToNanoseconds(inTime->hostTime)) - int64_t(hostTimeToNanoseconds(reference.hostTime));
+		outTime->videoTime = reference.videoTime + deltaNs / (1000000000ll / kVideoTimeScale);
+	}
+	else if ((inTime->flags & kCVTimeStampVideoTimeValid) && !(inTime->flags & kCVTimeStampHostTimeValid))
+	{
+		int64_t deltaNs = (inTime->videoTime - reference.videoTime) * (1000000000ll / kVideoTimeScale);
+		outTime->hostTime = reference.hostTime + nanosecondsToHostTime(uint64_t(deltaNs));
+	}
+
+	outTime->flags = kCVTimeStampVideoTimeValid | kCVTimeStampHostTimeValid
+		| kCVTimeStampVideoRefreshPeriodValid | kCVTimeStampRateScalarValid;
+	return kCVReturnSuccess;
+}
