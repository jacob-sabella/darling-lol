diff --git a/src/frameworks/Carbon/HIToolbox/src/TextServices.c b/src/frameworks/Carbon/HIToolbox/src/TextServices.c
new file mode 100644
index 000000000..cd91c8ec5
--- /dev/null
+++ b/src/frameworks/Carbon/HIToolbox/src/TextServices.c
@@ -0,0 +1,126 @@
+#include <HIToolbox/TextServices.h>
+#include <CarbonCore/MacErrors.h>
+#include <CoreFoundation/CoreFoundation.h>
+#include <os/lock.h>
+#include <string.h>
+
+/* The Text Services Manager keeps a bag of properties per document.  Only one of
+   them is asked for here: a program that puts up a password field sets the list
+   of input sources the field will accept, so that a user cannot type into it
+   through an input method that could keep what was typed.  There is one keyboard
+   under this runtime and no input methods at all, so narrowing the list cannot
+   change what the user is able to type - but the calls must still work, because
+   a program that cannot make them has no way to show a password field. */
+
+static os_unfair_lock g_propertiesLock = OS_UNFAIR_LOCK_INIT;
+static CFMutableDictionaryRef g_properties = NULL;
+
+/* A property belongs to one document and one tag, and both are numbers, so the
+   pair is what identifies it. */
+static CFStringRef copyPropertyKey(TSMDocumentID docID, OSType propertyTag)
+{
+	return CFStringCreateWithFormat(NULL, NULL, CFSTR("%u.%u"),
+	                                (unsigned) docID, (unsigned) propertyTag);
+}
+
+OSStatus TSMSetDocumentProperty(TSMDocumentID docID, OSType propertyTag,
+                                UInt32 propertySize, void* propertyData)
+{
+	CFStringRef key;
+	CFDataRef value;
+
+	if (propertyData == NULL && propertySize != 0)
+		return paramErr;
+
+	key = copyPropertyKey(docID, propertyTag);
+	if (key == NULL)
+		return memFullErr;
+
+	value = CFDataCreate(NULL, (const UInt8*) propertyData, propertySize);
+	if (value == NULL)
+	{
+		CFRelease(key);
+		return memFullErr;
+	}
+
+	os_unfair_lock_lock(&g_propertiesLock);
+
+	if (g_properties == NULL)
+		g_properties = CFDictionaryCreateMutable(NULL, 0, &kCFTypeDictionaryKeyCallBacks,
+		                                         &kCFTypeDictionaryValueCallBacks);
+
+	if (g_properties != NULL)
+		CFDictionarySetValue(g_properties, key, value);
+
+	os_unfair_lock_unlock(&g_propertiesLock);
+
+	CFRelease(value);
+	CFRelease(key);
+
+	return noErr;
+}
+
+OSStatus TSMGetDocumentProperty(TSMDocumentID docID, OSType propertyTag,
+                                UInt32 bufferSize, UInt32* actualSize, void* propertyBuffer)
+{
+	CFStringRef key;
+	CFDataRef value;
+	CFIndex length;
+
+	key = copyPropertyKey(docID, propertyTag);
+	if (key == NULL)
+		return memFullErr;
+
+	os_unfair_lock_lock(&g_propertiesLock);
+
+	value = (g_properties != NULL) ? CFDictionaryGetValue(g_properties, key) : NULL;
+
+	if (value == NULL)
+	{
+		os_unfair_lock_unlock(&g_propertiesLock);
+		CFRelease(key);
+		return paramErr;
+	}
+
+	length = CFDataGetLength(value);
+
+	if (actualSize != NULL)
+		*actualSize = (UInt32) length;
+
+	/* Asking with no buffer is how a caller finds out how much room it needs. */
+	if (propertyBuffer != NULL)
+	{
+		if ((CFIndex) bufferSize < length)
+		{
+			os_unfair_lock_unlock(&g_propertiesLock);
+			CFRelease(key);
+			return paramErr;
+		}
+
+		memcpy(propertyBuffer, CFDataGetBytePtr(value), length);
+	}
+
+	os_unfair_lock_unlock(&g_propertiesLock);
+	CFRelease(key);
+
+	return noErr;
+}
+
+OSStatus TSMRemoveDocumentProperty(TSMDocumentID docID, OSType propertyTag)
+{
+	CFStringRef key = copyPropertyKey(docID, propertyTag);
+
+	if (key == NULL)
+		return memFullErr;
+
+	os_unfair_lock_lock(&g_propertiesLock);
+
+	if (g_properties != NULL)
+		CFDictionaryRemoveValue(g_properties, key);
+
+	os_unfair_lock_unlock(&g_propertiesLock);
+
+	CFRelease(key);
+
+	return noErr;
+}
