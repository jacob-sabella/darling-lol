diff --git a/src/CoreAudio/AudioToolbox/lolac.h b/src/CoreAudio/AudioToolbox/lolac.h
new file mode 100644
index 000000000..94a20ee91
--- /dev/null
+++ b/src/CoreAudio/AudioToolbox/lolac.h
@@ -0,0 +1,35 @@
+/* LOL_AC: temporary instrumentation, remove before committing.
+   Chromium's GPU process loses its stderr, and stdio in it has proved
+   unreliable, so this writes straight to a file on the host with write(2). */
+#ifndef LOLAC_H
+#define LOLAC_H
+#include <fcntl.h>
+#include <unistd.h>
+#include <stdio.h>
+#include <stdarg.h>
+#include <pthread.h>
+
+static inline void lolACLog(const char* fmt, ...)
+{
+	static int fd = -2;
+	char buf[1024];
+	int n;
+	va_list ap;
+
+	if (fd == -2)
+		fd = open("/Volumes/SystemRoot/tmp/claude-1000/-home-@GUEST_USER@-Projects-darling/114a73b8-df7c-475c-ac0d-f66ca2fb68dc/scratchpad/lolac.log",
+			O_WRONLY | O_CREAT | O_APPEND, 0666);
+	if (fd < 0)
+		return;
+
+	n = snprintf(buf, sizeof(buf), "[%d:%d] ", (int) getpid(), (int) pthread_mach_thread_np(pthread_self()));
+	va_start(ap, fmt);
+	n += vsnprintf(buf + n, sizeof(buf) - n, fmt, ap);
+	va_end(ap);
+	if (n > (int) sizeof(buf))
+		n = sizeof(buf);
+	write(fd, buf, n);
+}
+
+#define LOL_AC(...) lolACLog(__VA_ARGS__)
+#endif
