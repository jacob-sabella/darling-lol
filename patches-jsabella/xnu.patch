+static bool execve_basename_is(const char* path, const char* name)
+{
+	const char* base = path;
+	const char* rest = NULL;
+	const char* p;
+
+	for (p = path; *p != '\0'; ++p) {
+		if (*p == '/')
+			base = p + 1;
+	}
+
+	return execve_prefix_match(base, name, &rest) && *rest == '\0';
