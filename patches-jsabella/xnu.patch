+	while (*p != '\0') {
+		while (*p == ' ')
+			++p;
+
+		if (*p == '\0')
+			break;
+
+		argv[count++] = p;
+
+		while (*p != '\0' && *p != ' ')
+			++p;
+
+		if (*p == ' ')
+			*p++ = '\0';
+	}
+
+	return count;
+}
