+static bool execve_prefix_match(const char* text, const char* prefix, const char** rest)
+{
+	const char* t = text;
+	const char* p = prefix;
+
+	while (*p != '\0') {
+		if (*t != *p)
+			return false;
+		++t;
+		++p;
+	}
+
+	if (rest != NULL)
+		*rest = t;
+
+	return true;
+}
+
+static const char* execve_getenv(const char** envp, const char* prefix)
+{
+	int i;
+
+	for (i = 0; envp != NULL && envp[i] != NULL; ++i) {
+		const char* value = NULL;
+
+		if (execve_prefix_match(envp[i], prefix, &value))
+			return value;
+	}
+
+	return NULL;
+}
