+// Resolves one of *another* process's descriptors to a macOS path.
+//
+// Kept out of _proc_pidfdinfo() because the unexpand buffer is 4KB and this
+// branch is the uncommon one; callers asking about their own descriptors go
+// through vchroot_fdpath(), which needs no buffer of ours at all.
+static long __attribute__((noinline)) _fd_path_of_other_proc(int32_t pid, int32_t fd, char* out, int32_t outsize)
+{
+	struct vchroot_unexpand_args args;
+	char link[64];
+	long rv;
+	__SIZE_TYPE__ len;
+
+	__simple_sprintf(link, "/proc/%d/fd/%d", pid, fd);
+
+	// /proc holds the native target, so it still has to be unexpanded.
+	rv = sys_readlink(link, args.path, sizeof(args.path) - 1);
+	if (rv < 0)
+		return rv;
+	args.path[rv] = '\0';
+
+	rv = vchroot_unexpand(&args);
+	if (rv != 0)
+		return rv;
+
+	len = strlen(args.path);
+	if (len >= (__SIZE_TYPE__) outsize)
+		return -ENAMETOOLONG;
+
+	memcpy(out, args.path, len + 1);
+	return 0;
+}
+
+// proc_pidfdinfo(), for the two vnode flavors.
+//
+// Riot's launcher uses PROC_PIDFDVNODEPATHINFO to find the path of its own
+// executable, and took the -ENOTSUP this used to return as "read 0 of the
+// 1200 bytes I asked for", which made it abandon the update it was in the
+// middle of and never start the client.
+static long _proc_pidfdinfo(int32_t pid, int32_t fd, uint32_t flavor, void* buffer, int32_t bufsize)
+{
+	struct proc_fileinfo* pfi;
+	struct vnode_info* vi;
+	char* path = NULL;
+	int32_t path_size = 0;
+	struct stat64 sb;
+	bool is_self;
+	long rv;
+
+	if (!buffer)
+		return -EFAULT;
+
+	switch (flavor)
+	{
+		case PROC_PIDFDVNODEINFO:
+		{
+			struct vnode_fdinfo* info = (struct vnode_fdinfo*) buffer;
+
+			if (bufsize < sizeof(*info))
+				return -ENOSPC;
+
+			memset(info, 0, sizeof(*info));
+			pfi = &info->pfi;
+			vi = &info->pvi;
+			break;
+		}
+		case PROC_PIDFDVNODEPATHINFO:
+		{
+			struct vnode_fdinfowithpath* info = (struct vnode_fdinfowithpath*) buffer;
+
+			if (bufsize < sizeof(*info))
+				return -ENOSPC;
+
+			memset(info, 0, sizeof(*info));
+			pfi = &info->pfi;
+			vi = &info->pvip.vip_vi;
+			path = info->pvip.vip_path;
+			path_size = sizeof(info->pvip.vip_path);
+			break;
+		}
+		default:
+			__simple_printf("sys_proc_info(): Unsupported pidfdinfo flavor: %d\n",
+					flavor);
+			return -ENOTSUP;
+	}
+
+	is_self = (pid == (int32_t) sys_getpid());
+
+	if (path)
+	{
+		if (is_self)
+		{
+			struct vchroot_fdpath_args fdpath_args = {
+				.fd = fd,
+				.path = path,
+				.maxlen = path_size,
+			};
+
+			rv = vchroot_fdpath(&fdpath_args);
+		}
+		else
+		{
+			rv = _fd_path_of_other_proc(pid, fd, path, path_size);
+		}
+
+		if (rv < 0)
+			return rv;
+	}
+
+	// Only the descriptor's owner can stat it by number; for anyone else the
+	// path we just resolved is the only handle we have on it.
+	if (is_self)
+		rv = sys_fstat64(fd, &sb);
+	else if (path)
+		rv = sys_stat64(path, &sb);
+	else
+		return -ESRCH;
+
+	if (rv < 0)
+		return rv;
+
+	_munge_vinfo_stat(&sb, &vi->vi_stat);
+	vi->vi_type = _vnode_type_for_mode(sb.st_mode);
+	vi->vi_fsid.val[0] = sb.st_dev;
+	vi->vi_fsid.val[1] = 0;
+
+	pfi->fi_type = PROX_FDTYPE_VNODE;
+
+	// The rest of proc_fileinfo describes the open file, which again only the
+	// owner can ask about. Leaving it zeroed for other processes is better
+	// than reporting our own descriptor's state as theirs.
+	if (is_self)
+	{
+		long long offset;
+		long flags;
+
+		flags = sys_fcntl_nocancel(fd, F_GETFL, 0);
+		if (flags >= 0)
+			pfi->fi_openflags = (uint32_t) flags;
+
+		flags = sys_fcntl_nocancel(fd, F_GETFD, 0);
+		if (flags > 0 && (flags & FD_CLOEXEC))
+			pfi->fi_status |= PROC_FP_CLEXEC;
+
+		// Harmless on a seekable file and simply fails on anything else.
+		offset = sys_lseek(fd, 0, SEEK_CUR);
+		if (offset >= 0)
+			pfi->fi_offset = offset;
+	}
+
+	return (flavor == PROC_PIDFDVNODEPATHINFO)
+		? sizeof(struct vnode_fdinfowithpath)
+		: sizeof(struct vnode_fdinfo);
+}
