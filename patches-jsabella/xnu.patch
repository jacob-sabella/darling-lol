+	{
+		case S_IFREG:	return VREG;
+		case S_IFDIR:	return VDIR;
+		case S_IFBLK:	return VBLK;
+		case S_IFCHR:	return VCHR;
+		case S_IFLNK:	return VLNK;
+		case S_IFSOCK:	return VSOCK;
+		case S_IFIFO:	return VFIFO;
+		default:	return VNON;
+	}
