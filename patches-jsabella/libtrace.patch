+/* Darling extension: DARLING_OS_LOG_STDERR echoes the unified log to stderr,
+   which is the only way to read it here, and also turns on the debug level. */
+static bool darling_os_log_verbose(void) {
+	static bool on = false;
+	static dispatch_once_t token;
+	dispatch_once(&token, ^{
+		on = getenv("DARLING_OS_LOG_STDERR") != NULL;
+	});
+	return on;
+}
+
 os_log_t os_log_create(const char *subsystem, const char *category) {
 	libtrace_precondition(subsystem != NULL, "subsystem cannot be NULL");
 	libtrace_precondition(category != NULL, "category cannot be NULL");
@@ -81,6 +95,14 @@ bool os_log_type_enabled(os_log_t log, os_log_type_t type) {
 	if (log == NULL) return false;
 	if (log->magic == OS_LOG_DISABLED_MAGIC) return false;
 
+	/* Debug logging is off unless somebody asks for it. Callers use this
+	   predicate to decide whether work that exists only to produce a log line
+	   is worth doing -- Security.framework, for one, symbolicates and demangles
+	   a 32-frame backtrace for every exception it throws when this returns
+	   true -- so claiming debug output is always wanted makes them pay for it
+	   even though nothing collects it. */
+	if (type == OS_LOG_TYPE_DEBUG) return darling_os_log_verbose();
+
 	return true;
 }
 
