+// Bounds-checked readScalar(). The buffer and the format string are emitted as
+// a matched pair by the caller's compiler, but if they ever disagree - or if we
+// misparse the format string - nothing downstream would stop us walking off the
+// end of the buffer and handing whatever we found there to strnlen() as a
+// pointer. libtrace_assert() is not fatal, so it cannot be the thing that stops
+// us; these checks have to.
+static bool readScalarAt(const uint8_t* buffer, uint32_t bufferSize, uint32_t bufferIndex, uint8_t length, uint64_t* outScalar) {
+	*outScalar = 0;
+	if ((uint64_t)bufferIndex + length > bufferSize) return false;
+	return readScalar((void*)&buffer[bufferIndex], length, outScalar);
+}
+
+// Read the type/privacy/size descriptor that precedes each argument.
+#define os_log_read_item_header()                                                            \
+	do {                                                                                     \
+		if ((uint64_t)bufferIndex + 2 > bufferSize) {                                        \
+			libtrace_assert(false, "os_log buffer ends in the middle of an argument");        \
+			goto malformed;                                                                  \
+		}                                                                                    \
+		itemType = buffer[bufferIndex] >> 4;                                                 \
+		privacy = buffer[bufferIndex] & 0x0f;                                                \
+		++bufferIndex;                                                                       \
+		itemSize = buffer[bufferIndex];                                                      \
+		++bufferIndex;                                                                       \
+	} while (0)
+
+// Read an `itemSize`-byte argument and step over it.
+#define os_log_read_scalar(out, what)                                                        \
+	do {                                                                                     \
+		if (!readScalarAt(buffer, bufferSize, bufferIndex, itemSize, (out))) {               \
+			libtrace_assert(false, "failed to read " what " from buffer");                   \
+			goto malformed;                                                                  \
+		}                                                                                    \
+		bufferIndex += itemSize;                                                             \
+	} while (0)
