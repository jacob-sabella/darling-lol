+	/* LOL_OSLOG: temporary instrumentation - remove before commit */
+	if (darling_os_log_verbose()) {
+		static const char *const lol_names[] = {
+			"DEFAULT", "INFO", "DEBUG", "ERROR", "FAULT"
+		};
+		const char *lol_type = "?";
+		switch (type) {
+			case OS_LOG_TYPE_DEFAULT: lol_type = lol_names[0]; break;
+			case OS_LOG_TYPE_INFO:    lol_type = lol_names[1]; break;
+			case OS_LOG_TYPE_DEBUG:   lol_type = lol_names[2]; break;
+			case OS_LOG_TYPE_ERROR:   lol_type = lol_names[3]; break;
+			case OS_LOG_TYPE_FAULT:   lol_type = lol_names[4]; break;
+		}
+		fprintf(stderr, "OSLOG[%d] %s %s/%s: %s\n", (int)getpid(), lol_type,
+				subsystem, category, decodedBuffer);
+		fflush(stderr);
+	}
 	asl_log(get_client(), message, level, "%s", decodedBuffer);
 	asl_release(message);
 	free(decodedBuffer);
