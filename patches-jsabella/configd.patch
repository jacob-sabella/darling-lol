+// Last error for the calling thread, as reported by SCError(). The stubs below
+// set it when they fail so that callers logging SCErrorString(SCError()) get
+// something truthful instead of "Success!".
+static __thread int _sc_last_error = kSCStatusOK;
+
+static void _SCSetLastError(int status)
+{
+	_sc_last_error = status;
+}
+
+int SCError(void)
+{
