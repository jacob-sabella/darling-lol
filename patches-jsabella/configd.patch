+/* Returns the argument following `keyword`, or NULL if the line does not start
+   with that keyword.  The keyword has to be followed by whitespace, so that
+   "nameserver" does not also match "nameserverish" and so that a bare keyword
+   does not send the caller reading past the end of the line. */
+static char* keyword_argument(char* line, const char* keyword)
+{
+	size_t length = strlen(keyword);
+
+	if (strncmp(line, keyword, length) != 0)
+		return NULL;
+
+	if (!isspace((unsigned char) line[length]))
+		return NULL;
+
+	line += length;
+	while (isspace((unsigned char) *line))
+		line++;
+
+	return *line ? line : NULL;
+}
