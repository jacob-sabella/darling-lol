diff --git a/CFForwardingPrep.S b/CFForwardingPrep.S
index a399c43..b47dc11 100644
--- a/CFForwardingPrep.S
+++ b/CFForwardingPrep.S
@@ -203,11 +203,9 @@ __CF_forwarding_prep_b:
 
 .section __TEXT,__text,regular,pure_instructions
 .globl __CF_forwarding_prep_0
-.globl __CF_forwarding_prep_1
 .align 4, 0x90
 
 __CF_forwarding_prep_0:
-__CF_forwarding_prep_1:
     .cfi_startproc
     .cfi_personality 155, ___objc_personality_v0
     push %rbp
@@ -283,6 +281,81 @@ Lfail:
 
     .cfi_endproc
 
+.globl __CF_forwarding_prep_1
+.align 4, 0x90
+
+// The stret entry point cannot share the code above: here %rdi is the caller's
+// return buffer and self is in %rsi, so the saved registers have to be read one
+// slot further along, and the value the caller expects back in %rax is that
+// buffer rather than anything the forwarded call produced.
+__CF_forwarding_prep_1:
+    .cfi_startproc
+    .cfi_personality 155, ___objc_personality_v0
+    push %rbp
+    .cfi_def_cfa_offset 16
+    .cfi_offset %rbp, -16
+    movq %rsp, %rbp
+    .cfi_def_cfa_register rbp
+
+    // Copy args from regs into a stack var
+    subq   $0xd0, %rsp
+    movq   %rax, 0xb0(%rsp)
+    movapd %xmm7, 0xa0(%rsp)
+    movapd %xmm6, 0x90(%rsp)
+    movapd %xmm5, 0x80(%rsp)
+    movapd %xmm4, 0x70(%rsp)
+    movapd %xmm3, 0x60(%rsp)
+    movapd %xmm2, 0x50(%rsp)
+    movapd %xmm1, 0x40(%rsp)
+    movapd %xmm0, 0x30(%rsp)
+    movq   %r9, 0x28(%rsp)
+    movq   %r8, 0x20(%rsp)
+    movq   %rcx, 0x18(%rsp)
+    movq   %rdx, 0x10(%rsp)
+    movq   %rsi, 8(%rsp)
+    movq   %rdi, (%rsp)
+
+    movq   %rsp, %rdi        // the saved registers
+    movq   (%rsp), %rsi      // write the result straight into the caller's buffer
+    call   ____forwarding_stret___
+
+    cmpq   $0, %rax          // check for forwarding completion
+    jne    Lstret_fail
+
+    // Struct returns come back through the hidden pointer, which the caller
+    // also expects to find in %rax.
+    movq   (%rsp), %rax
+
+    movq   %rbp, %rsp
+    pop    %rbp
+    ret
+
+Lstret_fail:
+    // if we got a non-nil value, it's our forwarding target
+    movq   %rax, %rsi        // self, not the return buffer, is the one to replace
+    movq   0xb0(%rsp), %rax
+    movapd 0xa0(%rsp), %xmm7
+    movapd 0x90(%rsp), %xmm6
+    movapd 0x80(%rsp), %xmm5
+    movapd 0x70(%rsp), %xmm4
+    movapd 0x60(%rsp), %xmm3
+    movapd 0x50(%rsp), %xmm2
+    movapd 0x40(%rsp), %xmm1
+    movapd 0x30(%rsp), %xmm0
+    movq   0x28(%rsp), %r9
+    movq   0x20(%rsp), %r8
+    movq   0x18(%rsp), %rcx
+    movq   0x10(%rsp), %rdx
+    movq   (%rsp), %rdi
+    // 8(%rsp) (self) deliberately not restored
+
+    movq   %rbp, %rsp
+    pop    %rbp
+
+    jmp    _objc_msgSend_stret // restart message send
+
+    .cfi_endproc
+
 .globl __CF_forwarding_prep_b
 .align 4, 0x90
 
