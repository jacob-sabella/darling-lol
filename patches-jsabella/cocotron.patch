+// Carbon virtual keycodes are positional, and so are X11 keycodes, so the
+// mapping is a pure table lookup in the direction x11ToCarbon does not go.
+// The table is small enough that scanning it beats keeping a reverse copy in
+// sync with it.
+static unsigned int X11KeycodeForCarbonKeyCode(CGKeyCode key)
+{
+	if (key == kVK_ANSI_A)
+		return kX11KeycodeForCarbonA;
+
+	for (unsigned int i = 0; i < 256; i++)
+	{
+		if (x11ToCarbon[i] == key)
+			return i;
+	}
+
+	// 0 is not a legal X11 keycode, so it doubles as "no such key here".
+	return 0;
+}
+
+-(BOOL) keyState:(CGKeyCode)key
+{
+	unsigned int keycode = X11KeycodeForCarbonKeyCode(key);
+	if (keycode == 0)
+		return NO;
+
+	// One bit per keycode, least significant bit first.
+	char keys[32];
+	XQueryKeymap(_display, keys);
+
+	return (keys[keycode >> 3] & (1 << (keycode & 7))) != 0;
+}
+
+-(BOOL) buttonState:(CGMouseButton)button
+{
+	unsigned int buttonMask;
+
+	// X11 and Apple disagree about which button is the second one: X numbers
+	// them left, middle, right while CGMouseButton is left, right, center.
+	switch (button)
+	{
+		case kCGMouseButtonLeft:   buttonMask = Button1Mask; break;
+		case kCGMouseButtonRight:  buttonMask = Button3Mask; break;
+		case kCGMouseButtonCenter: buttonMask = Button2Mask; break;
+		// Buttons past the third are numbered the same way in both, but the
+		// pointer state only reports the first five.
+		case 3:                    buttonMask = Button4Mask; break;
+		case 4:                    buttonMask = Button5Mask; break;
+		default:                   return NO;
+	}
+
+	Window child, root = DefaultRootWindow(_display);
+	int root_x, root_y;
+	int win_x, win_y;
+	unsigned int mask = 0;
+
+	XQueryPointer(_display, root, &root, &child, &root_x, &root_y, &win_x, &win_y, &mask);
+	return (mask & buttonMask) != 0;
+}
+
+-(CFTimeInterval) secondsSinceLastInputEvent
+{
+	/* The X server already keeps the number the caller is after - the screen
+	   saver's idle counter, reset by input on any client, which is the same
+	   scope as the window server's own. Asking it beats watching events go by
+	   here, because this connection only ever sees the events X decides to send
+	   it, and idleness is about the ones nobody got. */
+	static atomic_int haveExtension = -1;
+	int present = atomic_load(&haveExtension);
+
+	if (present < 0) {
+		int eventBase, errorBase;
+		present = XScreenSaverQueryExtension(_display, &eventBase, &errorBase) ? 1 : 0;
+		atomic_store(&haveExtension, present);
+	}
+
+	if (!present)
+		return 0;
+
+	/* XScreenSaverAllocInfo() mallocs; the struct is small and fixed, so it
+	   goes on the stack instead - this is polled, in some applications once a
+	   second forever. */
+	XScreenSaverInfo info = { 0 };
+
+	if (!XScreenSaverQueryInfo(_display, DefaultRootWindow(_display), &info))
+		return 0;
+
+	// info.idle is milliseconds.
+	return (CFTimeInterval) info.idle / 1000.0;
+}
