+- (void) addCommitHandler: (void (^)(void)) block
+                 forPhase: (CATransactionPhase) phase {
+    if (block == nil || phase >= CATransactionPhaseCount) {
+        return;
+    }
+
+    if (_commitHandlers[phase] == nil) {
+        _commitHandlers[phase] = [[NSMutableArray alloc] init];
+    }
