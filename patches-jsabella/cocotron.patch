+    /* Handlers outlive the caller's stack frame, and nothing guarantees an
+       autorelease pool around a commit, so the copy is owned outright. */
+    void (^copied)(void) = [block copy];
+
+    [_commitHandlers[phase] addObject: copied];
+    [copied release];
+}
+
+- (void) runCommitHandlersForPhase: (CATransactionPhase) phase {
+    if (phase >= CATransactionPhaseCount) {
+        return;
+    }
+
+    /* Detached first: a handler is allowed to register another one, and that
+       must not mutate the array being enumerated. */
+    NSMutableArray *handlers = _commitHandlers[phase];
+
+    _commitHandlers[phase] = nil;
+
+    for (void (^handler)(void) in handlers) {
+        handler();
+    }
+
+    [handlers release];
+}
