+    NSString *name = font->_name;
+    if ([name length] == 0)
+        return NO;
+
+    NSMutableDictionary *registry = O2FontRegistry();
+    [_registeredFontsLock lock];
+    BOOL wasThere = ([registry objectForKey: name] == font);
+    if (wasThere)
+        [registry removeObjectForKey: name];
+    [_registeredFontsLock unlock];
+
+    return wasThere;
