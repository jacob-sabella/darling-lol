+NSArray *O2FontCopyFamilyNames(void) {
+    NSArray *faces = O2FontCopyFaceList(nil);
+    NSMutableArray *names = [[NSMutableArray alloc] init];
+    NSMutableSet *seen = [NSMutableSet set];
