diff --git a/AppKit/X11.backend/X11IOProbe.m b/AppKit/X11.backend/X11IOProbe.m
new file mode 100644
index 00000000..480b3bc6
--- /dev/null
+++ b/AppKit/X11.backend/X11IOProbe.m
@@ -0,0 +1,37 @@
+/* LOL_XIO: temporary probe, revert before committing.
+ *
+ * Xlib's I/O error handler is told nothing about WHY the connection died.
+ * Modern Xlib is a shim over XCB, and XCB records the real reason in
+ * xcb_connection_t::has_error (one of the XCB_CONN_* codes). Neither the
+ * struct nor the field is public, but the layout is stable: _XDisplay::xcb
+ * points at a _X11XCBPrivate whose first member is the xcb_connection_t*,
+ * whose own first member is `int has_error`. Reach in and read it.
+ *
+ * This lives in its own translation unit because Xlibint.h drags in Xmd.h,
+ * whose BOOL typedef collides with the ObjC runtime's. */
+
+#define BOOL X11Xmd_BOOL
+#include <X11/Xlibint.h>
+#undef BOOL
+
+int lol_xcb_has_error(Display *display) {
+    struct _XDisplay *dpy = (struct _XDisplay *) display;
+    if (!dpy || !dpy->xcb)
+        return -1;
+    void *connection = *(void **) dpy->xcb;
+    if (!connection)
+        return -2;
+    return *(int *) connection;
+}
+
+// LOL_XIO: Xlib's own view of the request sequence. `request` is the sequence
+// number of the last request Xlib believes it has queued, `last_request_read`
+// the sequence of the reply it is currently dispatching. Comparing `request`
+// against the number of requests actually seen on the wire says whether Xlib's
+// counter has run ahead of reality.
+void lol_xlib_sequence(Display *display, unsigned long *request,
+                       unsigned long *lastRequestRead) {
+    struct _XDisplay *dpy = (struct _XDisplay *) display;
+    *request = dpy ? dpy->request : 0;
+    *lastRequestRead = dpy ? dpy->last_request_read : 0;
+}
