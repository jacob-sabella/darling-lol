+	Window child, root = DefaultRootWindow(_display);
+	int root_x, root_y;
+	int win_x, win_y;
+	unsigned int mask = 0;
+
+	XQueryPointer(_display, root, &root, &child, &root_x, &root_y, &win_x, &win_y, &mask);
