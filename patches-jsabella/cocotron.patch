+    NSString *name = font->_name;
+    if ([name length] == 0)
+        return NO;
+
+    NSMutableDictionary *registry = O2FontRegistry();
+    [_registeredFontsLock lock];
+    BOOL alreadyThere = ([registry objectForKey: name] != nil);
+    if (!alreadyThere)
+        [registry setObject: font forKey: name];
+    [_registeredFontsLock unlock];
+
+    return !alreadyThere;
