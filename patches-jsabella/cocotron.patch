+/* X has no such thing as a window with no width or height: CreateWindow and
+   ConfigureWindow both answer a zero with BadValue, so the window is either
+   never made or silently keeps the size it had.  AppKit hands us zero-sized
+   frames as a matter of course - a view that has not been laid out yet, a
+   window shrunk to nothing - and the caller has no way to tell that the server
+   threw the request away.  A one-pixel window is the smallest thing that
+   actually exists, and it behaves the way the caller expects. */
+static inline unsigned int X11ClampDimension(CGFloat value) {
+    return value >= 1.0 ? (unsigned int) value : 1;
