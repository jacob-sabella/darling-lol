+/* --- registry of application-supplied fonts ------------------------------ */
+
+static NSMutableDictionary *_registeredFonts = nil;
+static NSLock *_registeredFontsLock = nil;
+
+static NSMutableDictionary *O2FontRegistry(void) {
+    static dispatch_once_t once;
+    dispatch_once(&once, ^{
+        _registeredFonts = [[NSMutableDictionary alloc] init];
+        _registeredFontsLock = [[NSLock alloc] init];
+    });
+    return _registeredFonts;
+}
+
+BOOL O2FontRegisterFont(O2FontRef font) {
+    if (font == NULL)
+        return NO;
+
+    NSString *name = font->_name;
+    if ([name length] == 0)
+        return NO;
+
+    NSMutableDictionary *registry = O2FontRegistry();
+    [_registeredFontsLock lock];
+    BOOL alreadyThere = ([registry objectForKey: name] != nil);
+    if (!alreadyThere)
+        [registry setObject: font forKey: name];
+    [_registeredFontsLock unlock];
+
+    return !alreadyThere;
+}
+
+BOOL O2FontUnregisterFont(O2FontRef font) {
+    if (font == NULL)
+        return NO;
+
+    NSString *name = font->_name;
+    if ([name length] == 0)
+        return NO;
+
+    NSMutableDictionary *registry = O2FontRegistry();
+    [_registeredFontsLock lock];
+    BOOL wasThere = ([registry objectForKey: name] == font);
+    if (wasThere)
+        [registry removeObjectForKey: name];
+    [_registeredFontsLock unlock];
+
+    return wasThere;
+}
+
+O2FontRef O2FontCreateWithRegisteredName(NSString *name) {
+    if ([name length] == 0)
+        return NULL;
+
+    NSMutableDictionary *registry = O2FontRegistry();
+    [_registeredFontsLock lock];
+    O2FontRef font = [[registry objectForKey: name] retain];
+    [_registeredFontsLock unlock];
+
+    return font;
+}
+
 O2FontRef O2FontCreateWithFontName(NSString *name) {
+    /* A font the application registered itself wins over anything fontconfig
+       would dig up, and must win: fontconfig always returns *some* match, so
+       without this an app-supplied face could never be found by name. */
+    O2FontRef registered = O2FontCreateWithRegisteredName(name);
+    if (registered != NULL)
+        return registered;
+
     return O2FontCreateWithFontName_platform(name);
