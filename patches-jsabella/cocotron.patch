+-(CFTimeInterval) secondsSinceLastInputEvent
+{
+	/* The X server already keeps the number the caller is after - the screen
+	   saver's idle counter, reset by input on any client, which is the same
+	   scope as the window server's own. Asking it beats watching events go by
+	   here, because this connection only ever sees the events X decides to send
+	   it, and idleness is about the ones nobody got. */
+	static atomic_int haveExtension = -1;
+	int present = atomic_load(&haveExtension);
+
+	if (present < 0) {
+		int eventBase, errorBase;
+		present = XScreenSaverQueryExtension(_display, &eventBase, &errorBase) ? 1 : 0;
+		atomic_store(&haveExtension, present);
+	}
+
+	if (!present)
+		return 0;
+
+	/* XScreenSaverAllocInfo() mallocs; the struct is small and fixed, so it
+	   goes on the stack instead - this is polled, in some applications once a
+	   second forever. */
+	XScreenSaverInfo info = { 0 };
+
+	if (!XScreenSaverQueryInfo(_display, DefaultRootWindow(_display), &info))
+		return 0;
+
+	// info.idle is milliseconds.
+	return (CFTimeInterval) info.idle / 1000.0;
+}
