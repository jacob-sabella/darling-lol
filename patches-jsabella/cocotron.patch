+// Carbon virtual keycodes are positional, and so are X11 keycodes, so the
+// mapping is a pure table lookup in the direction x11ToCarbon does not go.
+// The table is small enough that scanning it beats keeping a reverse copy in
+// sync with it.
+static unsigned int X11KeycodeForCarbonKeyCode(CGKeyCode key)
+{
+	if (key == kVK_ANSI_A)
+		return kX11KeycodeForCarbonA;
+
+	for (unsigned int i = 0; i < 256; i++)
+	{
+		if (x11ToCarbon[i] == key)
+			return i;
+	}
+
+	// 0 is not a legal X11 keycode, so it doubles as "no such key here".
+	return 0;
