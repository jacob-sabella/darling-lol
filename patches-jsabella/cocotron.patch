+	// X11 and Apple disagree about which button is the second one: X numbers
+	// them left, middle, right while CGMouseButton is left, right, center.
+	switch (button)
+	{
+		case kCGMouseButtonLeft:   buttonMask = Button1Mask; break;
+		case kCGMouseButtonRight:  buttonMask = Button3Mask; break;
+		case kCGMouseButtonCenter: buttonMask = Button2Mask; break;
+		// Buttons past the third are numbered the same way in both, but the
+		// pointer state only reports the first five.
+		case 3:                    buttonMask = Button4Mask; break;
+		case 4:                    buttonMask = Button5Mask; break;
+		default:                   return NO;
+	}
