diff --git a/src/common/knote.c b/src/common/knote.c
index d0141aa..6c481a0 100644
--- a/src/common/knote.c
+++ b/src/common/knote.c
@@ -159,6 +159,54 @@ knote_get_by_data(struct filter *filt, intptr_t data)
 }
 #endif
 
+/* LOL_KQFREE: temporary, revert before committing. */
+extern void __simple_fprintf(int fd, const char* fmt, ...);
+static int lol_kqfree(void) {
+    static int on = -1;
+    if (on < 0) on = getenv("DARLING_KQMP") ? 1 : 0;
+    return on;
+}
+#define LOL_KQFREE(fmt, ...) do { if (lol_kqfree()) \
+    __simple_fprintf(2, "LOL_KQFREE[%d] " fmt "\n", getpid(), __VA_ARGS__); } while (0)
+
+/* Closing a kqueue has to tear down the knotes it still holds.  A knote is not
+   just bookkeeping: EVFILT_MACHPORT and EVFILT_PROC each own a kqchan socket
+   that darlingserver keeps writing notifications into for as long as it stays
+   open, so a knote that is merely forgotten leaves a channel alive in both
+   processes with nobody left to read it. */
+void
+knote_free_all(struct filter *filt)
+{
+    struct knote *kn;
+
+    LOL_KQFREE("ENTER filt=%d%s", filt->kf_id, "");
+    for (;;) {
+        pthread_rwlock_wrlock(&filt->kf_knote_mtx);
+        kn = RB_MIN(knt, &filt->kf_knote);
+        if (kn != NULL)
+            RB_REMOVE(knt, &filt->kf_knote, kn);
+        pthread_rwlock_unlock(&filt->kf_knote_mtx);
+
+        if (kn == NULL) {
+            LOL_KQFREE("EXIT filt=%d%s", filt->kf_id, "");
+            break;
+        }
+
+        if (kn->kn_flags & KNFL_KNOTE_DELETED) {
+            LOL_KQFREE("filt=%d already-deleted kn=%p", filt->kf_id, kn);
+            continue;
+        }
+
+        LOL_KQFREE("filt=%d deleting kn=%p ident=%lu dupfd=%d epfd=%d",
+            filt->kf_id, kn, (unsigned long) kn->kev.ident,
+            kn->kdata.kn_dupfd, kn->kn_epollfd);
+        filt->kn_delete(filt, kn);
+        kn->kn_flags |= KNFL_KNOTE_DELETED;
+        knote_release(kn);
+        LOL_KQFREE("filt=%d deleted kn=%p%s", filt->kf_id, kn, "");
+    }
+}
+
 int
 knote_disable(struct filter *filt, struct knote *kn)
 {
