 }
 
+/* A fork child inherits its parent's kqueue file descriptors, including the
+   kqchan sockets that EVFILT_MACHPORT and EVFILT_PROC knotes hold.  Those
+   channels still belong to the parent, so the child drops its copies without
+   running the teardown that would tell darlingserver to dismantle them. */
+int kqueue_in_atfork = 0;
+
 static void _kqueue_close_atfork_cb(int kqfd, void* kqptr, void* private)
 {
 	struct kqueue* kq = (struct kqueue*) kqptr;
@@ -314,7 +320,9 @@ void VISIBLE kqueue_atfork(void)
     {
         // Mutexes are not valid after a fork, reset it to unlocked state
         pthread_mutex_init(&kq_mtx, NULL);
+        kqueue_in_atfork = 1;
         map_foreach(kqmap, _kqueue_close_atfork_cb, NULL);
+        kqueue_in_atfork = 0;
     }
 }
 
