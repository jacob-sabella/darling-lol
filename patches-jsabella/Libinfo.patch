diff --git a/darling-resolver/resolver.c b/darling-resolver/resolver.c
index 6fb6e9e..bb3e9fb 100644
--- a/darling-resolver/resolver.c
+++ b/darling-resolver/resolver.c
@@ -50,6 +50,18 @@ dr_query(const char *name, int dns_class, int type, unsigned char *answer, int l
 	return result;
 }
 
+/* Every query here goes through the reentrant res_n* calls with a state of
+   this thread's own.  res_query() and its siblings share the single global
+   `_res`: the query id, the nameserver sockets and the virtual-circuit socket
+   all live in there, so two lookups in flight at the same time overwrite each
+   other's id and read each other's datagrams.  Each then sees an answer whose
+   id does not match, discards it as a stale reply and keeps waiting - until the
+   whole resolver timeout runs out and the lookup fails, even though the server
+   answered in milliseconds.  Nothing above this layer serialises lookups, and
+   anything that resolves from a dispatch queue or a thread pool - which is to
+   say any browser engine, and most network clients - does several at once as a
+   matter of course. */
+
 static int
 dr_is_valid(si_mod_t *si, si_item_t *item)
 {
@@ -71,6 +83,7 @@ dr_hostbyname(si_mod_t *si, const char *name, int af, const char *interface, uin
 	char* addr_buf;
 	void** addr_ptrs;
 	uint64_t ttl_end;
+	struct __res_state res;
 
 	if (af == AF_INET)
 	{
@@ -138,6 +151,7 @@ dr_hostbyaddr(si_mod_t *si, const void *addr, int af, const char *interface, uin
 	ns_msg msg;
 	ns_rr rr;
 	char** name_ptrs;
+	struct __res_state res;
 
 	if (af == AF_INET)
 	{
@@ -264,6 +278,17 @@ dr_addrinfo(si_mod_t *si, const void *node, const void *serv, uint32_t family, u
 		unsigned char buf[4096];
 		si_list_t *out = NULL;
 		si_list_t *list;
+		struct __res_state res;
+
+		/* One state for both halves of the lookup: the two queries run one
+		   after the other on this thread, so they can share it, and opening
+		   it once saves re-reading resolv.conf and re-making the socket. */
+		if (res_ninit(&res) != 0)
+		{
+			if (err)
+				*err = SI_STATUS_EAI_FAIL;
+			return NULL;
+		}
 		
 		if (resolveV6)
 		{
@@ -353,6 +378,7 @@ after_v6:
 		}
 		
 after_v4:
+		res_ndestroy(&res);
 		
 		return out;
 	}
